        <result property="keyanzhanghao" column="keyanzhanghao"/>
        <result property="keyanmima" column="keyanmima"/>
        <result property="keyanrenyuanxingming" column="keyanrenyuanxingming"/>
        <result property="touxiang" column="touxiang"/>
