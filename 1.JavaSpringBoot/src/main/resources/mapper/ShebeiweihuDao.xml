<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.ShebeiweihuDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.ShebeiweihuEntity" id="shebeiweihuMap">
        <result property="shebeibianhao" column="shebeibianhao"/>
        <result property="shebeimingcheng" column="shebeimingcheng"/>
        <result property="xinghao" column="xinghao"/>
        <result property="weihuzhanghao" column="weihuzhanghao"/>
        <result property="weihurenxingming" column="weihurenxingming"/>
        <result property="weihushijian" column="weihushijian"/>
        <result property="zhuangtai" column="zhuangtai"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.ShebeiweihuView" >

		SELECT  shebeiweihu.* FROM shebeiweihu  shebeiweihu 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.ShebeiweihuView" >
		SELECT * FROM shebeiweihu  shebeiweihu <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
